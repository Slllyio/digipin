{
  "name": "digipin",
  "version": "1.0.0",
  "description": "DigiPin Urban Intelligence: a static PWA that plots city data on India Post's DIGIPIN grid",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "serve": "python3 serve.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:py": "pytest -q",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:orphans": "python3 scripts/check-orphan-js.py",
    "check": "npm run lint && npm run check:orphans && npm test && npm run test:py",
    "golden:scores": "node pipeline/scores/gen_golden.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Slllyio/digipin.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Slllyio/digipin/issues"
  },
  "homepage": "https://github.com/Slllyio/digipin#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.58.2",
    "vitest": "^2.0.0"
  },
  "private": true
}
